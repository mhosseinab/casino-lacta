{"openapi": "3.1.0", "info": {"title": "casino-lacta", "version": "0.0.0"}, "paths": {"/auth/guest": {"post": {"tags": ["auth"], "summary": "Post Guest", "operationId": "post_guest_auth_guest_post", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GuestSessionResponse"}}}}}}}, "/auth/refresh": {"post": {"tags": ["auth"], "summary": "Post Refresh", "operationId": "post_refresh_auth_refresh_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessToken"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/me": {"get": {"tags": ["auth"], "summary": "Get Me", "operationId": "get_me_auth_me_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MeResponse"}}}}}, "security": [{"HTTPBearer": []}]}}, "/games/originals.crash/state": {"get": {"tags": ["crash"], "summary": "Get Crash State", "description": "The current shared Crash round + the caller's active bets (resume on reconnect).\n\nIdentity is the token's user \u2014 a caller sees ONLY its own bets. ``404`` if no\nCrash round has ever opened in this deployment.", "operationId": "get_crash_state_games_originals_crash_state_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Get Crash State Games Originals Crash State Get"}}}}}, "security": [{"HTTPBearer": []}]}}, "/games/{game_id}/bet": {"post": {"tags": ["games"], "summary": "Post Bet", "operationId": "post_bet_games__game_id__bet_post", "security": [{"HTTPBearer": []}], "parameters": [{"name": "game_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Game Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BetRequest"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BetObject"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/games/{game_id}/spin": {"post": {"tags": ["games"], "summary": "Post Spin", "description": "Slots spin (spec \u00a7461 ``POST /games/slots.{machineId}/spin``).\n\nA thin synonym for ``/bet``: a slot spin settles atomically through the SAME\nshared bet loop (single debit \u2192 engine outcome \u2192 single credit), so this adds NO\nper-game logic \u2014 it just exposes the spec's named slots endpoint. The response is\nthe \u00a72.2 bet object whose ``outcome`` carries the grid + line/feature wins.", "operationId": "post_spin_games__game_id__spin_post", "security": [{"HTTPBearer": []}], "parameters": [{"name": "game_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Game Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BetRequest"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BetObject"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/games/{game_id}/action": {"post": {"tags": ["games"], "summary": "Post Action", "description": "Advance a stateful round (Mines reveal/cashout, HiLo guess/cashout). Returns the\nsafe client-facing projection only \u2014 never hidden state. Identity is\nserver-authoritative.", "operationId": "post_action_games__game_id__action_post", "security": [{"HTTPBearer": []}], "parameters": [{"name": "game_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Game Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActionRequest"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Post Action Games  Game Id  Action Post"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/games/{game_id}/state": {"get": {"tags": ["games"], "summary": "Get State", "description": "The caller's most recent round for this game (resume after reconnect).\n\nIdentity is the token's user \u2014 a caller can only read its OWN round.", "operationId": "get_state_games__game_id__state_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "game_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Game Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Get State Games  Game Id  State Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/fairness/{bet_id}": {"get": {"tags": ["fairness"], "summary": "Get Fairness", "operationId": "get_fairness_fairness__bet_id__get", "parameters": [{"name": "bet_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Bet Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FairnessDisclosure"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/health": {"get": {"summary": "Health", "operationId": "health_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Response Health Health Get"}}}}}}}}, "components": {"schemas": {"AccessToken": {"properties": {"accessToken": {"type": "string", "title": "Accesstoken"}, "tokenType": {"type": "string", "title": "Tokentype", "default": "bearer"}}, "type": "object", "required": ["accessToken"], "title": "AccessToken"}, "ActionRequest": {"properties": {"roundId": {"type": "string", "title": "Roundid"}, "op": {"type": "string", "title": "Op"}, "cell": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Cell"}, "side": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Side"}}, "type": "object", "required": ["roundId", "op"], "title": "ActionRequest", "description": "The /action intent for a stateful round (Mines reveal/cashout, HiLo guess/cashout).\nIdentity comes from the token, NEVER the body; the server decides the outcome from its\nheld state. Per-game fields (``cell`` for Mines, ``side`` for HiLo) are optional \u2014\neach game validates the ones it needs in its pure ``step`` (the router stays generic)."}, "BetObject": {"properties": {"betId": {"type": "string", "title": "Betid"}, "gameId": {"type": "string", "title": "Gameid"}, "userId": {"type": "string", "title": "Userid"}, "walletId": {"type": "string", "title": "Walletid"}, "currency": {"type": "string", "title": "Currency"}, "mode": {"type": "string", "title": "Mode"}, "stakeMinor": {"type": "integer", "title": "Stakeminor"}, "status": {"type": "string", "title": "Status"}, "fairness": {"$ref": "#/components/schemas/Fairness"}, "input": {"additionalProperties": true, "type": "object", "title": "Input"}, "outcome": {"additionalProperties": true, "type": "object", "title": "Outcome"}, "createdAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Createdat"}, "settledAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Settledat"}, "idempotencyKeys": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Idempotencykeys"}}, "type": "object", "required": ["betId", "gameId", "userId", "walletId", "currency", "mode", "stakeMinor", "status", "fairness", "input", "outcome", "idempotencyKeys"], "title": "BetObject", "description": "The spec \u00a72.2 bet object \u2014 the return value of the loop / the REST envelope."}, "BetRequest": {"properties": {"betId": {"type": "string", "title": "Betid"}, "stakeMinor": {"type": "integer", "title": "Stakeminor"}, "currency": {"type": "string", "title": "Currency", "default": "GOLD"}, "mode": {"type": "string", "title": "Mode", "default": "PLAY"}, "input": {"additionalProperties": true, "type": "object", "title": "Input"}}, "type": "object", "required": ["betId", "stakeMinor"], "title": "BetRequest", "description": "The /bet intent. The client sends ONLY intent + stake; never an outcome and\nnever an identity \u2014 ``userId`` is intentionally absent (it comes from the token,\nso a client cannot even express acting as another user)."}, "Fairness": {"properties": {"serverSeedHash": {"type": "string", "title": "Serverseedhash"}, "clientSeed": {"type": "string", "title": "Clientseed"}, "nonce": {"type": "integer", "title": "Nonce"}}, "type": "object", "required": ["serverSeedHash", "clientSeed", "nonce"], "title": "Fairness", "description": "The public commit-reveal triple shown with a bet (spec \u00a72.2)."}, "FairnessDisclosure": {"properties": {"betId": {"type": "string", "title": "Betid"}, "gameId": {"type": "string", "title": "Gameid"}, "serverSeedHash": {"type": "string", "title": "Serverseedhash"}, "serverSeed": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Serverseed"}, "revealed": {"type": "boolean", "title": "Revealed"}, "clientSeed": {"type": "string", "title": "Clientseed"}, "nonce": {"type": "integer", "title": "Nonce"}, "derivation": {"type": "string", "title": "Derivation"}, "verifierUrl": {"type": "string", "title": "Verifierurl"}}, "type": "object", "required": ["betId", "gameId", "serverSeedHash", "serverSeed", "revealed", "clientSeed", "nonce", "derivation", "verifierUrl"], "title": "FairnessDisclosure", "description": "The \u00a72.10 fairness payload: seeds (+revealed), nonce, derivation, link."}, "GuestSessionResponse": {"properties": {"userId": {"type": "string", "title": "Userid"}, "walletId": {"type": "string", "title": "Walletid"}, "currency": {"type": "string", "title": "Currency"}, "mode": {"type": "string", "title": "Mode"}, "tokens": {"$ref": "#/components/schemas/TokenPair"}}, "type": "object", "required": ["userId", "walletId", "currency", "mode", "tokens"], "title": "GuestSessionResponse"}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "MeResponse": {"properties": {"userId": {"type": "string", "title": "Userid"}, "walletId": {"type": "string", "title": "Walletid"}, "currency": {"type": "string", "title": "Currency"}, "mode": {"type": "string", "title": "Mode"}, "balanceMinor": {"type": "integer", "title": "Balanceminor"}}, "type": "object", "required": ["userId", "walletId", "currency", "mode", "balanceMinor"], "title": "MeResponse"}, "RefreshRequest": {"properties": {"refreshToken": {"type": "string", "title": "Refreshtoken"}}, "type": "object", "required": ["refreshToken"], "title": "RefreshRequest"}, "TokenPair": {"properties": {"accessToken": {"type": "string", "title": "Accesstoken"}, "refreshToken": {"type": "string", "title": "Refreshtoken"}, "tokenType": {"type": "string", "title": "Tokentype", "default": "bearer"}}, "type": "object", "required": ["accessToken", "refreshToken"], "title": "TokenPair"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}, "securitySchemes": {"HTTPBearer": {"type": "http", "scheme": "bearer"}}}}
