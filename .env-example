# Copy to .env and adjust values for your environment.
# Docker Compose reads .env from the project root automatically.

# ---- Postgres ----
POSTGRES_USER=lacta
POSTGRES_PASSWORD=lacta
POSTGRES_DB=lacta

# ---- App database URL ----
# NOTE: the host MUST be "postgres" (the compose service name) so the app can
# reach the DB inside the network. Keep the user/password/db here in sync with
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
DATABASE_URL=postgresql+asyncpg://lacta:lacta@postgres:5432/lacta

# ---- Redis ----
# Host "redis" is the compose service name.
REDIS_URL=redis://redis:6379/0
